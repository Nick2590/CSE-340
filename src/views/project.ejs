<%- include('partials/header') %>

<main>
    <section class="project-details">
        <h1><%= project.title %></h1>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (isLoggedIn) { %>
            <section class="volunteer-panel" aria-label="Volunteer actions">
                <h2>Volunteer</h2>

                <% if (isVolunteering) { %>
                    <p class="volunteer-status volunteer-status-active">
                        You are volunteering for this project.
                    </p>

                    <form method="POST" action="/project/<%= project.project_id %>/unvolunteer">
                        <input type="hidden" name="returnTo" value="project">
                        <button class="btn btn-danger" type="submit">Remove Me as a Volunteer</button>
                    </form>
                <% } else { %>
                    <p class="volunteer-status">
                        Sign up to volunteer for this service project.
                    </p>

                    <form method="POST" action="/project/<%= project.project_id %>/volunteer">
                        <input type="hidden" name="returnTo" value="project">
                        <button class="btn" type="submit">Volunteer for This Project</button>
                    </form>
                <% } %>
            </section>
        <% } %>

        <% if (user && user.role_name === 'admin') { %>
            <p>
                <a href="/edit-project/<%= project.project_id %>">
                    Edit Project
                </a>
            </p>
        <% } %>

        <section class="project-categories">
            <h2>Categories</h2>

            <% if (categories.length > 0) { %>
                <div class="category-tags">
                    <% categories.forEach(category => { %>
                        <a
                            class="category-tag"
                            href="/category/<%= category.category_id %>"
                        >
                            <%= category.category_name %>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <p>No categories are assigned to this project.</p>
            <% } %>

            <% if (user && user.role_name === 'admin') { %>
                <p>
                    <a href="/project/<%= project.project_id %>/assign-categories">
                        Edit Categories
                    </a>
                </p>
            <% } %>
        </section>

        <p>
            <a href="/projects">Back to Upcoming Projects</a>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
